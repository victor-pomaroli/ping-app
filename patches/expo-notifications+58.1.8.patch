+  private fun drawableIdFromData(data: org.json.JSONObject?, key: String, prefix: String): Int? {
+    val name = data?.optString(key, "") ?: return null
+    if (!name.startsWith(prefix) || !name.matches(Regex("^[a-z0-9_]+$"))) return null
+    val id = context.resources.getIdentifier(name, "drawable", context.packageName)
+    if (id == 0) {
+      Log.w("expo-notifications", "Drawable \"$name\" ($key) not found")
+      return null
+    }
+    return id
+  }
+
+  private fun applyPingConversation(builder: NotificationCompat.Builder, content: INotificationContent, face: Bitmap) {
+    try {
+      val ping = Person.Builder()
+        .setKey(PING_PERSON_KEY)
+        .setName("Ping")
+        .setIcon(IconCompat.createWithBitmap(face))
+        .setImportant(true)
+        .build()
+      val user = Person.Builder().setKey("ping-user").setName("Você").build()
+      val style = NotificationCompat.MessagingStyle(user)
+        .setConversationTitle(content.title)
+        .setGroupConversation(true)
+        .addMessage(content.text ?: "", System.currentTimeMillis(), ping)
+      builder.setStyle(style)
+      builder.addPerson(ping)
+      if (ensurePingShortcut()) {
+        builder.setShortcutId(PING_SHORTCUT_ID)
+      }
+    } catch (e: Exception) {
+      Log.w("expo-notifications", "Could not apply Ping conversation style: ${e.message}")
+    }
+  }
+
+  // Android 11+ only treats MessagingStyle as a conversation (avatar on the left) when it points
+  // to a long-lived shortcut. One shared shortcut is enough: the avatar comes from each message.
+  private fun ensurePingShortcut(): Boolean = try {
+    val launch = context.packageManager.getLaunchIntentForPackage(context.packageName)
+    if (launch == null) {
+      false
+    } else {
+      launch.action = Intent.ACTION_MAIN
+      val shortcut = ShortcutInfoCompat.Builder(context, PING_SHORTCUT_ID)
+        .setShortLabel("Ping")
+        .setLongLived(true)
+        .setPerson(Person.Builder().setKey(PING_PERSON_KEY).setName("Ping").build())
+        .setIcon(IconCompat.createWithResource(context, context.applicationInfo.icon))
+        .setIntent(launch)
+        .build()
+      ShortcutManagerCompat.pushDynamicShortcut(context, shortcut)
+      true
+    }
+  } catch (e: Exception) {
+    Log.w("expo-notifications", "Could not publish Ping conversation shortcut: ${e.message}")
+    false
+  }
+
+  private fun largeIconFromData(data: org.json.JSONObject?): Bitmap? {
+    val id = drawableIdFromData(data, "largeIcon", "ping_face_") ?: return null
+    val name = context.resources.getResourceEntryName(id)
+    return try {
+      BitmapFactory.decodeResource(context.resources, id)
+    } catch (e: Exception) {
+      Log.w("expo-notifications", "Could not decode large icon \"$name\": ${e.message}")
+      null
+    }
+  }
