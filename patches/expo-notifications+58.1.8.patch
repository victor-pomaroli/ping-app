+  private fun drawableIdFromData(data: org.json.JSONObject?, key: String, prefix: String): Int? {
+    val name = data?.optString(key, "") ?: return null
+    if (!name.startsWith(prefix) || !name.matches(Regex("^[a-z0-9_]+$"))) return null
+    val id = context.resources.getIdentifier(name, "drawable", context.packageName)
+    if (id == 0) {
+      Log.w("expo-notifications", "Drawable \"$name\" ($key) not found")
+      return null
+    }
+    return id
+  }
+
+  // SystemUI draws a conversation with the shortcut's icon as avatar and the shortcut's label as
+  // title (ConversationNotificationProcessor). So each task gets its own hidden shortcut whose label
+  // is the notification title and whose icon is the bell face for this delay.
+  private fun applyPingConversation(builder: NotificationCompat.Builder, content: INotificationContent, face: Bitmap) {
+    try {
+      val faceIcon = IconCompat.createWithBitmap(face)
+      val ping = Person.Builder()
+        .setKey(PING_PERSON_KEY)
+        .setName("Ping")
+        .setIcon(faceIcon)
+        .setImportant(true)
+        .build()
+      val user = Person.Builder().setKey("ping-user").setName("Você").build()
+      val title = content.title?.toString()?.takeIf { it.isNotBlank() } ?: "Ping"
+      val style = NotificationCompat.MessagingStyle(user)
+        .setConversationTitle(title)
+        .setGroupConversation(false)
+        .addMessage(content.text ?: "", System.currentTimeMillis(), ping)
+      builder.setStyle(style)
+      builder.addPerson(ping)
+      val shortcutId = pingShortcutId(content)
+      if (pushPingShortcut(shortcutId, title, faceIcon)) {
+        builder.setShortcutId(shortcutId)
+      }
+    } catch (e: Exception) {
+      Log.w("expo-notifications", "Could not apply Ping conversation style: ${e.message}")
+    }
+  }
+
+  // One shortcut per task and face: the stages of a task don't overwrite each other's avatar,
+  // and the total stays small (Android evicts the oldest dynamic shortcuts when needed).
+  private fun pingShortcutId(content: INotificationContent): String {
+    val data = content.body
+    val face = data?.optString("largeIcon", "")?.removePrefix("ping_face_") ?: ""
+    val task = data?.optString("taskId", "")?.takeIf { it.isNotEmpty() }
+      ?: data?.optString("kind", "")?.takeIf { it.isNotEmpty() }
+      ?: "ping"
+    return "ping_${task}_$face".take(64)
+  }
+
+  private fun pushPingShortcut(id: String, label: String, icon: IconCompat): Boolean = try {
+    val launch = context.packageManager.getLaunchIntentForPackage(context.packageName)
+    if (launch == null) {
+      false
+    } else {
+      launch.action = Intent.ACTION_MAIN
+      val shortcut = ShortcutInfoCompat.Builder(context, id)
+        .setShortLabel(label.take(40))
+        .setLongLived(true)
+        .setPerson(Person.Builder().setKey(PING_PERSON_KEY).setName("Ping").build())
+        .setIcon(icon)
+        .setIntent(launch)
+        .setExcludedFromSurfaces(ShortcutInfoCompat.SURFACE_LAUNCHER)
+        .build()
+      ShortcutManagerCompat.pushDynamicShortcut(context, shortcut)
+      true
+    }
+  } catch (e: Exception) {
+    Log.w("expo-notifications", "Could not publish Ping conversation shortcut: ${e.message}")
+    false
+  }
