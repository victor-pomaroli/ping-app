+  private fun largeIconFromData(data: org.json.JSONObject?): Bitmap? {
+    val name = data?.optString("largeIcon", "") ?: return null
+    if (!name.matches(Regex("^ping_face_[a-z0-9_]+$"))) return null
+    val id = context.resources.getIdentifier(name, "drawable", context.packageName)
+    if (id == 0) {
+      Log.w("expo-notifications", "Large icon \"$name\" not found in drawables")
+      return null
+    }
+    return try {
+      BitmapFactory.decodeResource(context.resources, id)
+    } catch (e: Exception) {
+      Log.w("expo-notifications", "Could not decode large icon \"$name\": ${e.message}")
+      null
+    }
+  }
